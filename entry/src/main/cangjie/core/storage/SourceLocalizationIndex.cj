package ohos_app_cangjie_entry.core.storage

import std.collection.HashMap

/**
 * Source-derived index for target UI literals.
 *
 * Every entry is generated from Telegram-iOS/en.lproj/Localizable.strings;
 * it is only a compatibility path for migrated views that still pass the source
 * English fallback instead of the canonical lang-pack key.
 */
private let SOURCE_ENGLISH_KEYS: HashMap<String, String> = buildSourceEnglishKeys()

/**
 * Populate the built-in English component used by Telegram's PresentationStrings.
 *
 * The source ships a complete English Localizable.strings component and overlays
 * downloaded language packs on top of it.  Keeping that component complete is
 * important when switching away from a downloaded language: already-mounted UI
 * rows must resolve their canonical key instead of falling back to an old title
 * value captured before the switch.
 */
public func applySourceEnglishDefaults(target: HashMap<String, String>): Unit {
    for ((english, key) in SOURCE_ENGLISH_KEYS) {
        if (key.size > 0) {
            target[key] = english
        }
    }
}

