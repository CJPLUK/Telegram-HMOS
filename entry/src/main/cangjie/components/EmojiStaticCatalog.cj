// Generated literals are materialized once per process. The previous accessor
// rebuilt 1,651 String arrays on every category switch and every keystroke.
private let iosPeopleCatalog = iosPeopleEmojis()
private let iosAnimalsCatalog = iosAnimalsAndNatureEmojis()
private let iosFoodCatalog = iosFoodAndDrinkEmojis()
private let iosActivityCatalog = iosActivityAndSportEmojis()
private let iosTravelCatalog = iosTravelAndPlacesEmojis()
private let iosObjectsCatalog = iosObjectsEmojis()
private let iosSymbolsCatalog = iosSymbolsEmojis()
private let iosFlagsCatalog = iosFlagsEmojis()

private func buildAllIOSStaticEmojis(): Array<String> {
    let result = ArrayList<String>()
    for (emoji in iosPeopleCatalog) { result.add(emoji) }
    for (emoji in iosAnimalsCatalog) { result.add(emoji) }
    for (emoji in iosFoodCatalog) { result.add(emoji) }
    for (emoji in iosActivityCatalog) { result.add(emoji) }
    for (emoji in iosTravelCatalog) { result.add(emoji) }
    for (emoji in iosObjectsCatalog) { result.add(emoji) }
    for (emoji in iosSymbolsCatalog) { result.add(emoji) }
    for (emoji in iosFlagsCatalog) { result.add(emoji) }
    return result.toArray()
}

private let iosAllStaticCatalog = buildAllIOSStaticEmojis()

public func getIOSCategoryIcons(): Array<String> {
    return ["😀", "🐻", "🍔", "⚽️", "🚗", "💡", "❤️", "🏳️"]
}

public func getIOSCategoryName(index: Int64): String {
    let names: Array<String> = [
        "Smileys & People", "Animals & Nature", "Food & Drink", "Activity",
        "Travel & Places", "Objects", "Symbols", "Flags"
    ]
    if (index >= 0 && index < Int64(names.size)) { return names[index] }
    return ""
}

public func getIOSCategoryEmojis(index: Int64): Array<String> {
    if (index == 0) { return iosPeopleCatalog }
    if (index == 1) { return iosAnimalsCatalog }
    if (index == 2) { return iosFoodCatalog }
    if (index == 3) { return iosActivityCatalog }
    if (index == 4) { return iosTravelCatalog }
    if (index == 5) { return iosObjectsCatalog }
    if (index == 6) { return iosSymbolsCatalog }
    return iosFlagsCatalog
}

public func allIOSStaticEmojis(): Array<String> {
    return iosAllStaticCatalog
}


